VITE_BASE=/

# 管理 API：与 Go `/api/v1/admin` 同源代理时使用 `/admin-api`，或由网关直接指向完整 origin
VITE_GLOB_API_URL=/admin-api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
